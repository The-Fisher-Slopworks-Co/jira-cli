{
  "name": "@slopworks/jira-cli",
  "version": "0.1.0",
  "description": "A Jira command-line client for AI agents and for old on-prem Jira.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Fisher-Slopworks-Co/jira-cli.git"
  },
  "bugs": {
    "url": "https://github.com/The-Fisher-Slopworks-Co/jira-cli/issues"
  },
  "homepage": "https://github.com/The-Fisher-Slopworks-Co/jira-cli#readme",
  "keywords": [
    "jira",
    "jira-server",
    "jira-data-center",
    "cli",
    "cookie-auth",
    "terminal"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "jira": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSES",
    "REUSE.toml"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "bun run src/cli.ts",
    "prepublishOnly": "bun run clean && bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.ts\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.ts\"",
    "knip": "knip",
    "reuse": "uvx reuse lint",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run knip && bun run reuse && bun run test",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@slopworks/jira": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
